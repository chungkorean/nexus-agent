{
  "name": "nexus-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Paperclip이 지휘하고 OpenCode·Claude Code가 실행하는 하이브리드 에이전트 OS",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "node scripts/build-adapter.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "settings": "node scripts/build-settings.mjs && node apps/nexus-server/dist/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/executor-antigravity": "workspace:*",
    "@nexus/executor-claude-code": "workspace:*",
    "@nexus/executor-opencode": "workspace:*",
    "@nexus/paperclip-client": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
